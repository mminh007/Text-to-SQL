# Copy this file to .env and fill in the real values
# cp .env.example .env

# ── Groq API (for data generation) ────────────────────────────────────────────
OPENAI_API_KEY=gsk_your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# ── SQL Server ─────────────────────────────────────────────────────────────────
SQL_CONN_STR=Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=music_14_09_2026;UID=sa;PWD=your_password;

# ── HuggingFace tokens ─────────────────────────────────────────────────────────
# READ token  → download models, sentence-transformers dedup
#   Permission: "read" is enough
#   Get: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_read_token_here

# WRITE token → push fine-tuned model to Hub (only needed for --push-to-hub)
#   Permission: "write" required
#   Get: https://huggingface.co/settings/tokens → New token → Role: Write
HF_TOKEN_WRITE=hf_your_write_token_here

# ── Rate limiting (data generation) ───────────────────────────────────────────
DAILY_REQUEST_LIMIT=250
OTPM_LIMIT=1000
OTPM_SAFETY_FACTOR=1.3
LOG_FILE=data/run.log
